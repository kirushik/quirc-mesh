{
  "name": "quirc-mesh",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com:kirushik/quirc-mesh.git"
  },
  "type": "module",
  "description": "Small auditable pure-JS QR decoder that reads high-version (v20-v40) codes from a camera, via piecewise alignment-pattern mesh sampling. Fork of dlbeer/quirc.",
  "license": "ISC",
  "keywords": ["qr", "qrcode", "decoder", "quirc", "mesh", "camera", "reed-solomon"],
  "exports": {
    ".": "./src/index.js"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "files": [
    "src/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "harness": "node harness/run.mjs",
    "synth:gen": "node harness/gen-distorted.mjs",
    "synth": "node harness/run-synth.mjs",
    "bench": "node harness/bench.mjs",
    "fuzz": "node harness/fuzz.mjs",
    "serve": "node harness/serve.mjs",
    "manifest": "node test-vectors/build-manifest.mjs"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "zxing-wasm": "^1.0.0"
  }
}
